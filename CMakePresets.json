{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/toolchain-luckfox-pico.cmake",
      "cacheVariables": {
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "HostDebug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RMG_BUILD_DEVICE_TARGETS": "OFF",
        "RMG_BUILD_EXAMPLES": "OFF",
        "RMG_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "HostDebug",
      "configurePreset": "HostDebug"
    }
  ],
  "testPresets": [
    {
      "name": "HostDebug",
      "configurePreset": "HostDebug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
